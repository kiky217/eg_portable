# Do NOT copy placeholders. Generate real secrets (they are validated for length, charset and entropy):
#   python tools/generate_secrets.py .env          (creates a new 0600 file; never overwrites)
# Notary keypair (the private key stays on the trusted producer, never in the gateway):
#   python tools/generate_notary_keypair.py ./notary
EVALUATION_GATEWAY_API_KEY=
EVALUATION_GATEWAY_HITL_KEY=
EVALUATION_GATEWAY_AUDIT_HMAC_KEY=
EVALUATION_GATEWAY_EVIDENCE_PUBLIC_KEY_B64=
EVALUATION_GATEWAY_EXECUTOR_PUBLIC_KEY_B64=
EVALUATION_GATEWAY_TRUSTED_EVIDENCE_UID=10001
EVALUATION_GATEWAY_UID=10001
EVALUATION_GATEWAY_GID=10001
# Optional tunables (bounded; defaults in app/main.py):
