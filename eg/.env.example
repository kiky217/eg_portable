# Do NOT copy placeholders. Generate real secrets (they are validated for length, charset and entropy):
#   python tools/generate_secrets.py .env          (creates a new 0600 file; never overwrites)
# Notary keypair (the private key stays on the trusted producer, never in the gateway):
#   python tools/generate_notary_keypair.py ./notary
EVALUATION_GATEWAY_API_KEY=
EVALUATION_GATEWAY_HITL_KEY=
EVALUATION_GATEWAY_AUDIT_HMAC_KEY=
EVALUATION_GATEWAY_EVIDENCE_PUBLIC_KEY_B64=
EVALUATION_GATEWAY_EXECUTOR_PUBLIC_KEY_B64=
EVALUATION_GATEWAY_TRUSTED_EVIDENCE_UID=10001
EVALUATION_GATEWAY_UID=10001
EVALUATION_GATEWAY_GID=10001
# Optional tunables (bounded; defaults in app/main.py):
# EVALUATION_GATEWAY_EVIDENCE_MAX_AGE_SECONDS=300      # 1..86400
# EVALUATION_GATEWAY_CLOCK_SKEW_SECONDS=30             # 0..300
# EVALUATION_GATEWAY_INTEGRITY_CACHE_SECONDS=15        # 0..300

# Required before physical E0/E2 PRE: must match provisioned worker output_root
# (absent -> no concrete action READY, fail closed).
# EVALUATION_GATEWAY_EXECUTOR_OUTPUT_ROOT=/secured/worker/outputs

# E3-E5 registered adapter metadata is NOT a live executor.
# Intentionally not enabled by docker-compose or default portable launch:
# EVALUATION_GATEWAY_HIGH_EFFECT_CAPABILITIES_JSON=
# EVALUATION_GATEWAY_HITL_PUBLIC_KEY_B64=
# Independently authenticated E3-E5 production worker transport is not yet
# provisioned. A registry JSON and HITL signature cannot enable that transport.

# Optional bounded E2 nested source paths. Default depth=0 (root files only).
# Parent directories MUST exist and be private 0700, worker-owned and non-symlink.
# The separate worker JSON must have the same allowed_subdir_depth setting.
# EVALUATION_GATEWAY_EXECUTOR_MAX_SUBDIR_DEPTH=1

# Operator-provisioned external high-effect adapters (NOT enabled by default):
# EVALUATION_GATEWAY_EXTERNAL_ADAPTER_MODE=disabled
# EVALUATION_GATEWAY_EXTERNAL_ADAPTER_SOCKET=/run/eg-adapter/effect.sock
# EVALUATION_GATEWAY_EXTERNAL_ADAPTER_UID=12000
# EVALUATION_GATEWAY_HIGH_EFFECT_CAPABILITIES_JSON=[]
# EVALUATION_GATEWAY_HITL_PUBLIC_KEY_B64=operator-ed25519-public-key-base64
# Never reuse the notary/executor key or CI-only adapter as production.
